manifest {
  name = 'minMutFinder'
  author = 'Ignasi Prats Méndez'
  contributors = [
    [name:"Ignasi Prats Méndez", contribution:['author']],
    [name:"Alejandra González-Sánchez", contribution:['maintainer']],
    [name:"Marc Pérez i Bautista", contribution:['maintainer']]
  ]
  homePage = 'https://github.com/ignasi-pratsmendez/minMutFinder.git'
  description = 'Minority Mutation Finder'
  mainScript = 'minMutFinder.nf'
  version = '2.0.0'
}

// ── Core parameters ────────────────────────────────────────────────────────
params {
    help     = false
    h        = false
    version  = false
    v        = false
    out_path = false
    r1       = false
    r2       = false
    ref_seq  = false
    annotate = false
    syn_muts = "no"
    mapping  = "minimap2"
    vcf      = false
    areads   = false
    AF       = 0.05
    depth    = 20
    threads  = 4
    SB       = 999

    // projectDir = directory of main.nf — correct in nf-test context
    // baseDir    = directory from which nextflow is launched — may be /tmp in nf-test
    programs = [
        all_muts_finder          : "${projectDir}/bin/all_muts_finder.py",
        annotate_and_viz         : "${projectDir}/bin/annotate_and_viz.py",
        by_protein_analysis      : "${projectDir}/bin/by_protein_analysis.py",
        cigar_remove             : "${projectDir}/bin/cigar_remove.py",
        expand_vcf_rows          : "${projectDir}/bin/expand_vcf_rows.py",
        get_text                 : "${projectDir}/bin/get_text.py",
        in_vcf                   : "${projectDir}/bin/in_vcf.py",
        indel_mutations_finder   : "${projectDir}/bin/indel_mutations_finder.py",
        minority_mutations_finder: "${projectDir}/bin/minority_mutations_finder.py",
        read_count               : "${projectDir}/bin/read_count.py",
        read_metrics             : "${projectDir}/bin/read_metrics.py",
        read_assembler           : "${projectDir}/bin/read_assembler.py",
        ref_check                : "${projectDir}/bin/ref_check.py",
        replacer_vcm             : "${projectDir}/bin/replacer_vcm.py",
        replacer                 : "${projectDir}/bin/replacer.py",
        sam_bam_processing       : "${projectDir}/bin/sam_bam_processing.py",
        seq_reader               : "${projectDir}/bin/seq_reader.py",
        translateDNA             : "${projectDir}/bin/translateDNA.py",
        tsv2vcf                  : "${projectDir}/bin/tsv2vcf.py",
        variant_codon_mutation   : "${projectDir}/bin/variant_codon_mutation.py",
        visualizer               : "${projectDir}/bin/visualizer.py",
        viz_no_annotate          : "${projectDir}/bin/viz_no_annotate.py"
    ]
}

// profiles must be outside params block
profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    conda {
        conda.enabled = true
    }
    test {
        process.cpus   = 4
        process.memory = 8.GB
    }
}